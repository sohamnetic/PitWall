# PitWall for hosts without a persistent disk (Render's free tier): the data is baked into
# the image instead of mounted. The archive comes from the `deploy-data` branch, built by
# scripts/pack_data.py; anything written at runtime (game picks) is lost on restart.
#   docker build -f Dockerfile.render -t pitwall-render .
#   docker run -p 10000:10000 pitwall-render

# ---- frontend build (also served here, so this one URL works on its own) ----
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---- runtime ----
FROM python:3.10-slim
# LightGBM needs the OpenMP runtime.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/pyproject.toml backend/
COPY backend/f1p backend/f1p
RUN pip install --no-cache-dir ./backend

COPY --from=web /web/dist /app/frontend/dist

# One thread each: shared hosts report many cores but grant a fraction of one, and
# OpenMP / BLAS / joblib starting a thread per reported core makes them crawl.
ENV F1P_DATA_DIR=/data \
    F1P_STATIC_DIR=/app/frontend/dist \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    LOKY_MAX_CPU_COUNT=1

# ADD re-downloads when the archive changes, so a data update busts the cache from here on.
ARG DATA_URL=https://raw.githubusercontent.com/sohamnetic/PitWall/deploy-data/pitwall-data.tar.gz
ADD ${DATA_URL} /tmp/pitwall-data.tar.gz
RUN mkdir -p /data && tar -xzf /tmp/pitwall-data.tar.gz -C /data && rm /tmp/pitwall-data.tar.gz
# Use the archive's trained models (this image matches the Python 3.10 they were built with);
# retrain only if they don't load here.
RUN python -c "from f1p.models.race_model import RaceModel; [RaceModel.load(s) for s in ('pre', 'post')]" \
    || f1p train
RUN useradd --create-home --uid 1000 f1 && chown -R f1 /data
USER f1

EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\", 10000)}/api/health')"

# Render sets PORT; default to its usual 10000 elsewhere.
CMD ["sh", "-c", "exec uvicorn f1p.api.server:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers"]
